        <offset><position x="0" y="0" z="0"/></offset>
        <macro ref="vas_th_local_highway_sector09_macro" connection="sector">
          <connections>
            <connection ref="entrypoint">
              <macro path="../../vas_th_s09_highway_zone_connection" connection="vas_th_pursuit_highway_entry_gate"/>
            </connection>
            <connection ref="exitpoint">
