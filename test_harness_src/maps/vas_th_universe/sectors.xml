<?xml version="1.0" encoding="utf-8"?>
<!--
  25 test sectors. Zone macro names keep their original "C##" scenario tags from the
  vanilla-patch version of this harness (so jobs.xml / md keep working unchanged); the
  C## no longer refers to a vanilla cluster, it is just a stable scenario id.

  Per-sector layout (zone offsets within the sector):
    s01 ARG vs TER Military         : Home(0,0,0)  ArgonForce(+300,-150)  TerranForce(+300,+150)
    s02 ARG vs TER Defence Stations : ArgonForce(+300,-150)  TerranStations(+300,+150)   [MD stations]
    s03 ARG vs TER Civil Ships      : ArgonForce(+300,-150)  TerranCivil(+300,+150)
    s04 ARG vs TER Civil Stations   : ArgonForce(+300,-150)  TerranStation(+300,+150)    [MD station]
    s05 Player vs PAR Defence Stations: PlayerForce(+300,-150) ParanidStation(+300,+150) [MD station]
    s06 Player vs PAR Civil Stations  : PlayerForce(+300,-150) ParanidStation(+300,+150) [MD station]
    s07 Player vs PAR Military      : PlayerForce(+300,-150) ParanidMil(+300,+150)
    s08 Player vs PAR Civil Ships   : PlayerForce(+300,-150) ParanidCivil(+300,+150)
    s09 Highway Pursuit  : one 300 km local highway
    s10 Gate Pursuit A   : origin-side gate
    s11 Gate Pursuit B   : destination-side gate
    s12 Distance Pursuit : one wide empty zone
    s13 Player Highway Pursuit  : one 300 km local highway
    s14 Player Gate Pursuit A   : origin-side gate
    s15 Player Gate Pursuit B   : destination-side gate
    s16 Player Distance Pursuit : one wide empty zone
    s17 Direct TER/ARG Size Pursuit    : one wide empty zone
    s18 Direct Player/PAR Size Pursuit : one wide empty zone
    s19 Active Fight Pursuit           : one wide empty zone
    s20 Targeting Friendly Bystander   : one compact zone
    s21 Targeting VFF Secondary        : one compact zone
    s22 Targeting Civilian Secondary Scan: one compact zone
    s23 MoveGeneric Gate Pursuit A     : origin-side gate
    s24 MoveGeneric Gate Pursuit B     : destination-side gate
    s25 Station Route Waypointing      : one wide station/ship zone
    s26 Hidden VFF Commander A         : visible subordinate + scanner
    s27 Hidden VFF Commander B         : unseen commander
  (offsets in metres; force zones are 300 km apart so spawns do not overlap)
-->
<macros xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <!-- s01 ARG vs TER Military (+ player home) -->
  <macro name="vas_th_sector01_macro" class="sector">
    <component ref="standardsector"/>
    <connections>
      <connection name="vas_th_s01_home_connection" ref="zones">
        <offset><position x="0" y="0" z="0"/></offset>
        <macro ref="zone_vas_th_s01_home_macro" connection="sector"/>
      </connection>
      <connection name="vas_th_s01_argon_connection" ref="zones">
        <offset><position x="300000" y="0" z="-150000"/></offset>
        <macro ref="zone_vas_th_s01_argonforce_macro" connection="sector"/>
      </connection>
      <connection name="vas_th_s01_terran_connection" ref="zones">
        <offset><position x="300000" y="0" z="150000"/></offset>
        <macro ref="zone_vas_th_s01_terranforce_macro" connection="sector"/>
      </connection>
    </connections>
  </macro>

