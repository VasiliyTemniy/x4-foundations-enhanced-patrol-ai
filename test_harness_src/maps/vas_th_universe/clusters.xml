  <macro name="vas_th_cluster01_macro" class="cluster">
    <component ref="standardcluster"/>
    <connections>
      <connection name="vas_th_cluster01_sector_connection" ref="sectors">
        <offset><position x="0" y="0" z="0"/></offset>
        <macro ref="vas_th_sector01_macro" connection="cluster"/>
      </connection>
      <connection ref="content"><macro><component connection="space" ref="Cluster_35"/></macro></connection>
    </connections>
  </macro>

