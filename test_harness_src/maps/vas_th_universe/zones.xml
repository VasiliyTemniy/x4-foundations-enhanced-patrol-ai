    </connections>
  </macro>

  <!-- s16 Player/Paranid Distance Pursuit -->
  <macro name="zone_vas_th_pursuit_player_distance_macro" class="zone"><component ref="standardzone"/><connections></connections></macro>

  <!-- s17 Direct Attack TER/ARG Size Pursuit -->
  <macro name="zone_vas_th_pursuit_direct_ter_arg_macro" class="zone"><component ref="standardzone"/><connections></connections></macro>

  <!-- s18 Direct Attack Player/PAR Size Pursuit -->
  <macro name="zone_vas_th_pursuit_direct_player_par_macro" class="zone"><component ref="standardzone"/><connections></connections></macro>

  <!-- s19 Active Fight Pursuit -->
  <macro name="zone_vas_th_pursuit_active_fight_macro" class="zone"><component ref="standardzone"/><connections></connections></macro>

  <!-- s20 Targeting: friendly bystander after primary kill -->
  <macro name="zone_vas_th_targeting_friendly_macro" class="zone"><component ref="standardzone"/><connections></connections></macro>

