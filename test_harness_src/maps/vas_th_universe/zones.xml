  <macro name="zone_vas_th_pursuit_movegeneric_gate_origin_macro" class="zone">
    <component ref="standardzone"/>
    <connections>
      <connection name="connection_vas_th_pursuit_movegeneric_gate_origin_to_dest" ref="gates">
