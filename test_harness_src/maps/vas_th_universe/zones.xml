        </offset>
        <macro ref="props_gates_anc_gate_macro" connection="space"/>
      </connection>
    </connections>
  </macro>

  <!-- s25 Station Route Waypointing -->
  <macro name="zone_vas_th_station_waypoint_macro" class="zone"><component ref="standardzone"/><connections></connections></macro>

  <!-- s26/s27 Targeting: visible subordinate whose commander is not visible -->
  <macro name="zone_vas_th_hidden_vff_scan_macro" class="zone">
    <component ref="standardzone"/>
    <connections>
      <connection name="connection_vas_th_hidden_vff_scan_to_commander" ref="gates">
        <offset>
          <position x="0" y="0" z="0"/>
          <quaternion qx="0" qy="0" qz="0" qw="1"/>
        </offset>
