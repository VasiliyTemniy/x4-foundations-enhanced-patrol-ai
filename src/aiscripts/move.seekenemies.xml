<?xml version="1.0" encoding="utf-8" ?>
<diff>
  <!-- EPAI enable flag passed by Patrol. -->
  <!-- FRAGILITY - NONE: adds one optional move.seekenemies parameter.
       INJECTION FAIL IMPACT: if this injection fails, move.seekenemies cannot receive Patrol's resolved
                              EPAI enable flag, which means the whole mod would stop working for Patrol scans. -->
  <add sel="//params">
    <param name="vas_epai_enabled" default="false"/>
  </add>

  <!-- Wake up because the Combat Logic WakeTick MD cue fired. -->
  <!-- FRAGILITY - LOW: selector anchors to vanilla's move_to interrupt condition list.
       INJECTION FAIL IMPACT: if this injection fails, CL heartbeat signals will not interrupt Patrol movement,
                              which means the whole mod stops working. -->
  <add sel="//move_to/interrupt/conditions/check_any" pos="prepend">
    <event_object_signalled object="this.sector" param="'vas_cl_wake'" check="false" comment="patrol must work even if no other interrupt events happen"/>
  </add>

  <!-- Convert CL wake signals into throttled sector scans, then swallow the heartbeat. -->
  <!-- FRAGILITY - LOW: selector anchors to vanilla's move_to interrupt actions.
       INJECTION FAIL IMPACT: if this injection fails, vas_cl_wake signals are not turned into EPAI scan attempts,
                              which means the whole mod stops working. -->
  <add sel="//move_to/interrupt/actions" pos="prepend">
    <!-- Run enhanced patrol scan at most once per configured interval -->
    <set_value name="$vas_epai_check" exact="false"/>
    <set_value name="$vas_epai_interval" exact="if (@player.entity.$vas_epai_interval + '') == 'null' then 30s else player.entity.$vas_epai_interval"/>
    <do_if value="@$vas_epai_enabled
              and event.name == 'event_object_signalled'
              and event.param == 'vas_cl_wake'
              and not $recon
              and not $plunder
              and (not @$vas_epai_last_scan_time or $vas_epai_last_scan_time + $vas_epai_interval lt player.age)">
      <set_value name="$vas_epai_check" exact="true"/>
      <set_value name="$vas_epai_last_scan_time" exact="player.age"/>
      <resume label="vas_epai_scan"/>
    </do_if>

    <!-- The wake heartbeat is only for EPAI scan timing; do not let vanilla signal handling treat it as an enemy report. -->
    <do_if value="event.name == 'event_object_signalled' and event.param == 'vas_cl_wake'">
      <set_value name="$vas_epai_check" exact="false"/>
      <resume label="moveto"/>
    </do_if>

  </add>

  <!-- EPAI scan continuation reached from the wake interrupt above. -->
  <!-- FRAGILITY - MEDIUM: selector depends on vanilla's move_to layout.
       INJECTION FAIL IMPACT: if this injection fails, EPAI wake interrupts can request a scan but
                              no sector-wide EPAI scan runs, which means the whole mod stops working. -->
  <add sel="//move_to" pos="after">
    <label name="vas_epai_scan"/>

    <set_value name="$vas_epai_should_run_scan_engine" exact="@$vas_epai_enabled and @$vas_epai_check and not $recon and not $plunder"/>

    <do_if value="$vas_epai_should_run_scan_engine">
      <set_value name="$vas_epai_debug_chance" exact="if (@player.entity.$vas_epai_debug_chance + '') == 'null' then 0 else player.entity.$vas_epai_debug_chance"/>

      <!-- One sector-wide wake signals every CL scanner in the sector in the same tick, so nobody
           can see a sibling's Attack order issued moments earlier this same wake - it isn't committed
           yet. Ticket per sector (reset by the CL WakeTick right before signalling) staggers same-tick
           ships by a few ms each, enough to cross into the next tick so earlier commits become visible. -->
      <set_value name="$vas_epai_wake_ticket" exact="if (@global.$vas_cl_wake_ticket.{this.sector} + '') == 'null' then 0 else global.$vas_cl_wake_ticket.{this.sector}"/>
      <set_value name="global.$vas_cl_wake_ticket.{this.sector}" exact="$vas_epai_wake_ticket + 1"/>
      <do_if value="$vas_epai_wake_ticket gt 0">
        <debug_to_file chance="$vas_epai_debug_chance" name="this.ship.idcode" directory="'VAS_EnhancedPatrolAI'" text="'[' + player.age + '] scan deferred by ' + $vas_epai_wake_ticket * 3ms" append="true"/>
        <wait exact="$vas_epai_wake_ticket * 3ms"/>
      </do_if>

      <!-- Faction gates decide who may run EPAI at all, so a patrol that is gated off can never join
           a fight - it must not be counted as a potential ally either. With NPC factions off, only
           player-owned patrols qualify; Xenon/Kha'ak are hostile to everyone and can never appear in
           a friendly VFF list, so their gates need no equivalent here. -->
      <set_value name="$vas_epai_potential_ally_owners" exact="if @player.entity.$vas_epai_apply_to_npc_factions then null else [faction.player]"/>

      <run_script name="'lib.vas.cl.scan'" result="$vas_epai_potential_target_groups">
        <param name="scan_interval" value="$vas_epai_interval"/>
        <param name="max_attack_init_distance" value="player.entity.$vas_epai_max_attack_init_distance"/>
        <param name="skip_ship_may_attack" value="@player.entity.$vas_epai_skip_ship_mayattack"/>
        <param name="skip_station_may_attack" value="@player.entity.$vas_epai_skip_station_mayattack"/>
        <param name="attack_ships" value="@player.entity.$vas_epai_attack_ships"/>
        <param name="attack_stations" value="@player.entity.$vas_epai_attack_stations"/>
        <param name="visibility_all_seeing" value="@player.entity.$vas_epai_all_seeing"/>
        <param name="visibility_allied_vision" value="@player.entity.$vas_epai_allied_vision"/>
        <param name="potential_ally_combatant_force_coefficient" value="player.entity.$vas_epai_pending_patrol_force_coefficient"/>
        <param name="potential_ally_owners" value="$vas_epai_potential_ally_owners"/>
        <param name="force_estimation_deviation" value="player.entity.$vas_epai_force_estimation_deviation"/>
        <param name="ship_join_threshold" value="player.entity.$vas_epai_ship_join_threshold"/>
        <param name="ship_overcommit_limit" value="player.entity.$vas_epai_ship_overcommit_limit"/>
        <param name="station_join_threshold" value="player.entity.$vas_epai_station_join_threshold"/>
        <param name="station_initiation_threshold" value="player.entity.$vas_epai_station_initiation_threshold"/>
        <param name="debugchance" value="$vas_epai_debug_chance"/>
        <param name="debugdirectory" value="'VAS_EnhancedPatrolAI'"/>
        <save_retval name="potential_target_scores" variable="$vas_epai_potential_target_scores"/>
        <save_retval name="blocking_stations" variable="$vas_epai_blocking_stations"/>
        <save_retval name="sector_enemy_stations" variable="$vas_epai_sector_enemy_stations"/>
      </run_script>
      <do_if value="@$vas_epai_potential_target_groups and $vas_epai_potential_target_groups.count != 0">
        <resume label="vas_epai_attack" />
      </do_if>
    </do_if>

    <!-- <resume label="vas_epai_attack" /> was not called which means
         @$vas_epai_potential_target_groups.count == 0 but the scan was tried - means it was still kinda skipped -->
    <do_if value="$vas_epai_should_run_scan_engine">
      <debug_to_file chance="$vas_epai_debug_chance" name="this.ship.idcode" directory="'VAS_EnhancedPatrolAI'" text="'[' + player.age + '] scan skipped; resume=moveto'" append="true"/>
      <set_value name="$vas_epai_check" exact="false"/>
      <resume label="moveto" />
    </do_if>
  </add>

  <!-- Final EPAI target selection and Attack order issuing. -->
  <!-- FRAGILITY - NONE: selector anchors to the actions tag, which must exist for aiscripts.
       INJECTION FAIL IMPACT: if this injection fails, EPAI scans may find and score targets but cannot
                              issue EPAI Attack orders, which means the mod would stop working. -->
  <add sel="//attention/actions">
    <label name="vas_epai_attack"/>

    <!-- If the scan was not done or epai is not enabled at all -
         skip right away to the end to make sure that no messed up
         or uninitizalied values are read -->
    <do_if value="not (@$vas_epai_enabled and @$vas_epai_check and @$vas_epai_potential_target_groups and $vas_epai_potential_target_groups.count gt 0)">
      <resume label="vas_epai_engine_end"/>
    </do_if>

    <!-- Target groups are self-contained: primary target plus its ready-to-use secondary
         targets list, so no CL cache internals are touched from this mod. -->
    <set_value name="$vas_epai_selected_group" exact="$vas_epai_potential_target_groups.{1}"/>
    <set_value name="$vas_epai_selected_target" exact="$vas_epai_selected_group.$primarytarget"/>
    <set_value name="$vas_epai_selected_target_subordinates_flatlist" exact="@$vas_epai_selected_group.$secondarytargets"/>

    <debug_to_file chance="$vas_epai_debug_chance" name="this.ship.idcode" directory="'VAS_EnhancedPatrolAI'" text="'[' + player.age + '] issue attack from move.seekenemies target=' + $vas_epai_selected_target.idcode + ' ' + $vas_epai_selected_target.knownname + ' class=' + $vas_epai_selected_target.class + ' secondaryTargets=' + @$vas_epai_selected_target_subordinates_flatlist.count" append="true"/>

    <!-- Post-attack follow-up marker. Patrol re-enters from 'start' once the immediate Attack order
         finishes; this marker tells it to rescan there instead of flying all the way back to its
         patrol space. Set here rather than in CL - Patrol re-entry is EPAI policy, CL knows nothing
         about it. Cleared by the consumer in order.fight.patrol; dead ships swept by the EPAI GC. -->
    <do_if value="not @global.$vas_epai_should_scan_at_patrol_start">
      <set_value name="global.$vas_epai_should_scan_at_patrol_start" exact="table[]"/>
    </do_if>
    <set_value name="global.$vas_epai_should_scan_at_patrol_start.{this.ship}" exact="true"/>

    <run_script name="'lib.vas.cl.issue.attack'">
      <param name="primary_target" value="$vas_epai_selected_target"/>
      <param name="secondary_targets" value="$vas_epai_selected_target_subordinates_flatlist"/>
      <param name="blocking_stations" value="$vas_epai_blocking_stations"/>
      <param name="sector_enemy_stations" value="$vas_epai_sector_enemy_stations"/>
      <param name="pursue_distance" value="player.entity.$vas_epai_max_pursue_travel_distance"/>
      <param name="skip_ship_mayattack" value="@player.entity.$vas_epai_skip_ship_mayattack"/>
      <param name="skip_station_mayattack" value="@player.entity.$vas_epai_skip_station_mayattack"/>
      <param name="approach_max_waypoints" value="player.entity.$vas_epai_approach_max_waypoints"/>
      <param name="debugchance" value="$vas_epai_debug_chance"/>
    </run_script>

    <label name="vas_epai_engine_end"/>
  </add>
</diff>
