<?xml version="1.0" encoding="utf-8" ?>
<diff>
  <!-- Internal flags used by Enhanced Patrol AI attacks that deliberately override vanilla mayattack checks. -->
  <!-- FRAGILITY - NONE: adds internal params to the Attack order definition.
       INJECTION FAIL IMPACT: EPAI-only pursuit clamping and mayattack override propagation will not receive
                              their flags, but vanilla order flow and most parts of this mod remains intact. -->
  <add sel="/aiscript/order/params">
    <param name="vas_epai_issued_by_epai" default="false" type="internal"/>
    <param name="vas_epai_skip_ship_mayattack" default="false" type="internal"/>
    <param name="vas_epai_skip_station_mayattack" default="false" type="internal"/>
  </add>

  <!--
    EPAI wake interrupt.
    This interrupt handler expects that the referencing script has the following variables initialized:
      $vas_epai_issued_by_epai
      $target
      $pursuedistance

    EPAI attacks run with vanilla pursuetargets=true, so low-level fight/move scripts keep the
    target alive cleanly. This wake handler restores the patrol's max travel budget on EPAI's own
    sector scheduler instead of relying on gravidar events.

    Movement while already inside weapon range is combat maneuvering, not pursuit travel. In that
    case refresh the anchor under the ship and return immediately, so a long fight does not consume
    the pursuit budget or later add one huge drift step.
    -->
  <!-- FRAGILITY - NONE: adds a standalone handler keyed to EPAI's own sector wake signal.
       INJECTION FAIL IMPACT: if this injection fails, EPAI pursuit bounds are still checked when vanilla
                              re-enters the fight label, but long low-level pursuit legs may not be interrupted
                              on the wake cadence, which in practice means that most of the time mod's pursuit
                              range distance will be disregarded -->
  <add sel="/aiscript/interrupts">
    <handler>
      <conditions>
        <event_object_signalled object="this.sector" param="'wake_up_patrol'" comment="EPAI max pursuit travel handling"/>
        <check_value value="@$vas_epai_issued_by_epai"/>
        <check_value value="@$target.exists"/>
      </conditions>
      <actions>
        <set_value name="$vas_epai_within_combat_range" exact="this.assignedcontrolled.bboxdistanceto.{$target} le this.assignedcontrolled.maxcombatrange.all"/>

        <!-- Active combat: keep the sample point fresh, but do not count combat movement as pursuit. -->
        <do_if value="$vas_epai_within_combat_range">
          <create_position name="$vas_epai_pursuit_previous_pos" space="this.ship.sector" object="this.ship"/>
          <set_value name="$vas_epai_pursuit_previous_space" exact="this.ship.sector"/>
          <return/>
        </do_if>

        <!-- Pursuit movement: add the distance travelled since the last wake sample, then resample. -->
        <do_if value="@$vas_epai_pursuit_previous_pos">
          <set_value name="$vas_epai_pursuit_distance_travelled"
                     exact="@$vas_epai_pursuit_distance_travelled + this.ship.distanceto.[$vas_epai_pursuit_previous_space, $vas_epai_pursuit_previous_pos]"/>
        </do_if>
        <create_position name="$vas_epai_pursuit_previous_pos" space="this.ship.sector" object="this.ship"/>
        <set_value name="$vas_epai_pursuit_previous_space" exact="this.ship.sector"/>

        <!-- If the ship has travelled too far and still has not brought the target into combat range, end the EPAI attack order. -->
        <do_if value="@$vas_epai_pursuit_distance_travelled + this.assignedcontrolled.bboxdistanceto.{$target} gt $pursuedistance">
          <set_value name="$abort"/>
          <abort_called_scripts resume="finish"/>
        </do_if>
      </actions>
    </handler>
  </add>

  <!-- Keep subordinate attack orders on the same mayattack override rules as the patrol-created parent attack.
         Vanilla creates subordinate attacks from both escort-group helpers and local target splitting. -->
  <!-- FRAGILITY - LOW: selector anchors to a specific vanilla subordinate Attack creation object.
       INJECTION FAIL IMPACT: escort-group subordinate attacks may lose EPAI flags while the commander's attack
                              still works, which means subordinates can fail to bypass vanilla attack hostility
                              checks and potentially the pursuit range bounds -->
  <add sel="//create_order[@id=&quot;'Attack'&quot; and @object=&quot;$_locsub&quot;]">
    <param name="vas_epai_issued_by_epai" value="@$vas_epai_issued_by_epai"/>
    <param name="vas_epai_skip_ship_mayattack" value="@$vas_epai_skip_ship_mayattack"/>
    <param name="vas_epai_skip_station_mayattack" value="@$vas_epai_skip_station_mayattack"/>
  </add>

  <!-- These two share the same object expression, so disambiguate by primarytarget to avoid a multi-match. -->
  <!-- FRAGILITY - MEDIUM: selector depends on vanilla's local target-splitting variable names.
       INJECTION FAIL IMPACT: subordinates assigned to split subtargets may lose EPAI flags and fall back to vanilla
                              mayattack/pursuit semantics, which means subordinates can fail to bypass vanilla
                              attack hostility checks and potentially the pursuit range bounds -->
  <add sel="//create_order[@id=&quot;'Attack'&quot; and @object=&quot;$subordinates.{$i}&quot; and param[@name=&quot;primarytarget&quot; and @value=&quot;$subtarget&quot;]]">
    <param name="vas_epai_issued_by_epai" value="@$vas_epai_issued_by_epai"/>
    <param name="vas_epai_skip_ship_mayattack" value="@$vas_epai_skip_ship_mayattack"/>
    <param name="vas_epai_skip_station_mayattack" value="@$vas_epai_skip_station_mayattack"/>
  </add>
  <!-- FRAGILITY - MEDIUM: selector depends on vanilla's local target-splitting variable names.
       INJECTION FAIL IMPACT: subordinates assigned to split subtargets may lose EPAI flags and fall back to vanilla
                              mayattack/pursuit semantics, which means subordinates can fail to bypass vanilla
                              attack hostility checks and potentially the pursuit range bounds -->
  <add sel="//create_order[@id=&quot;'Attack'&quot; and @object=&quot;$subordinates.{$i}&quot; and param[@name=&quot;primarytarget&quot; and @value=&quot;$target&quot;]]">
    <param name="vas_epai_issued_by_epai" value="@$vas_epai_issued_by_epai"/>
    <param name="vas_epai_skip_ship_mayattack" value="@$vas_epai_skip_ship_mayattack"/>
    <param name="vas_epai_skip_station_mayattack" value="@$vas_epai_skip_station_mayattack"/>
  </add>

  <!-- EPAI attacks always use pursuetargets=true; restore patrol bounds before vanilla fight logic runs. -->
  <!-- FRAGILITY - LOW: label 'fight' is a stable vanilla control-flow anchor.
       INJECTION FAIL IMPACT: if this injection fails, EPAI attacks may pursue beyond patrol sector/range. -->
  <add sel="//label[@name=&quot;fight&quot;]" pos="after">
    <do_if value="@$vas_epai_issued_by_epai">
      <do_if value="@$target.exists">
        <do_if value="this.ship.sector and $target.sector and this.ship.sector != $target.sector">
          <set_value name="$abort"/>
          <resume label="finish"/>
        </do_if>
      </do_if>
    </do_if>
  </add>

  <!--
    mayattack rejects killmilitary civilian/logistics targets even after EPAI deliberately selected them.
    Ship and station overrides are separate: station overrides are useful for countering invasions, while ship
    overrides can shred civilian economy flows if enabled too broadly.
    -->
  <!-- This do_if appears twice (the outer disengage gate and the post-relation-boost re-check); anchor to the outer
         gate via its distinctive child do_if so the selector is unambiguous. Bypassing the outer gate skips the inner one. -->
  <!-- FRAGILITY - HIGH: selector matches the outer mayattack gate by exact value plus a distinctive child do_if.
                         will fail being injected only together with the lower replace injection;
       INJECTION FAIL IMPACT: EPAI civilian/station mayattack overrides can fail. -->
  <add sel="//do_if[@value=&quot;not this.mayattack.{$target}&quot; and do_if[@value=&quot;$checkrelation and (not $target.coverowner or $allowothertargets or not this.isplayerowned)&quot;]]" pos="before">
    <set_value name="$vas_epai_attack_target_root" exact="
               if (@$target.isclass.ship or @$target.isclass.station) then $target
          else if @$target.container.exists then $target.container
          else if @$target.defensible.exists then $target.defensible
          else $target" />
  </add>

  <!--
    Replacement value, formatted:
      not this.mayattack.{$target}
      and not (
        ((@$target.isclass.ship or @$vas_epai_attack_target_root.isclass.ship) and @$vas_epai_skip_ship_mayattack)
        or ((@$target.isclass.station or @$vas_epai_attack_target_root.isclass.station) and @$vas_epai_skip_station_mayattack)
      )
    - - -
    KEEP IN SYNC WITH THE ACTUAL REPLACEMENT!
    -->
  <!-- FRAGILITY - HIGH: selector matches the same exact outer mayattack gate as the root setup above.
                         will fail being injected only together with the lower replace injection;
       INJECTION FAIL IMPACT: EPAI-selected hostile civilian/logistics ships or stations
                              may be cancelled by vanilla mayattack. -->
  <replace sel="//do_if[@value=&quot;not this.mayattack.{$target}&quot; and do_if[@value=&quot;$checkrelation and (not $target.coverowner or $allowothertargets or not this.isplayerowned)&quot;]]/@value">not this.mayattack.{$target} and not (((@$target.isclass.ship or @$vas_epai_attack_target_root.isclass.ship) and @$vas_epai_skip_ship_mayattack) or ((@$target.isclass.station or @$vas_epai_attack_target_root.isclass.station) and @$vas_epai_skip_station_mayattack))</replace>
</diff>
