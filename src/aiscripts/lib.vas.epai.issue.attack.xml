<?xml version="1.0" encoding="utf-8"?>
<aiscript name="lib.vas.epai.issue.attack"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="aiscripts.xsd">
  <params>
    <param name="primarytarget" comment="Selected primary target that must be attacked. Make sure that this value is not null - outside of this aiscript"/>
    <param name="secondarytargets" default="null" comment="Secondary targets list must be provided for ships only, stations must be attacked one by one"/>
    <param name="blockingstations" default="null" comment="Stations detected on the route to the selected target; used for approach path orders"/>
    <param name="sectorenemystations" default="null" comment="All valid enemy stations in the selected target sector; used for approach path validation"/>
  </params>

  <attention min="unknown">
    <actions>
      <!-- Uncomment if debug would ever be required here -->
      <!-- <set_value name="$vas_epai_debug_chance" exact="if (@player.entity.$vas_epai_debug_chance + '') == 'null' then 0 else player.entity.$vas_epai_debug_chance"/> -->

      <!-- Global map of patrol should-scan markers per-ship -->
      <do_if value="not @global.$vas_epai_should_scan_at_patrol_start">
        <set_value name="global.$vas_epai_should_scan_at_patrol_start" exact="table[]"/>
      </do_if>
      <set_value name="global.$vas_epai_should_scan_at_patrol_start.{this.ship}" exact="true"/>

      <set_value name="$vas_epai_max_pursue_travel_distance" exact="player.entity.$vas_epai_max_pursue_travel_distance"/>
      <set_value name="$vas_epai_skip_ship_mayattack" exact="@player.entity.$vas_epai_skip_ship_mayattack"/>
      <set_value name="$vas_epai_skip_station_mayattack" exact="@player.entity.$vas_epai_skip_station_mayattack"/>

      <create_order id="'Attack'" object="this.ship" immediate="true">
        <param name="primarytarget" value="$primarytarget"/>
        <param name="secondarytargets" value="$secondarytargets"/>
        <param name="allowothertargets" value="false"/>
        <param name="pursuetargets" value="true"/>
        <param name="pursuedistance" value="$vas_epai_max_pursue_travel_distance"/>
        <param name="vas_epai_issued_by_epai" value="true"/>
        <param name="vas_epai_skip_ship_mayattack" value="$vas_epai_skip_ship_mayattack"/>
        <param name="vas_epai_skip_station_mayattack" value="$vas_epai_skip_station_mayattack"/>
        <param name="checkrelation" value="false"/>
        <param name="internalorder" value="true"/>
      </create_order>

      <!-- If the enemy is in sight - just attack it. -->
      <do_if value="this.ship.cansee.{$primarytarget}">
        <!-- Wait to make sure no "ACHTUNG! INFINITE LOOP DETECTED" errors are produced -->
        <wait min="1ms" max="2ms"/>
        <return/>
      </do_if>

      <!-- Target not currently visible; plan a physical approach. -->

      <!-- Plan fixed detour waypoints around stations on the straight route.
           The VFF branch cache was refreshed by the scan that called this helper. GC only removes
           entries after they have been expired for more than 3 seconds, so using it here as the
           current friendly fleet size is intentional. -->
      <set_value name="$vas_epai_approach_waypoints" exact="[]"/>
      <set_value name="$vas_epai_approach_max_waypoints" exact="player.entity.$vas_epai_approach_max_waypoints"/>

      <!-- Skip waypoint construction if no waypoints are allowed or no enemy stations are present -->
      <do_if value="$vas_epai_approach_max_waypoints == 0
            or not (@$sectorenemystations and $sectorenemystations.count gt 0)
            or not (@$blockingstations and $blockingstations.count gt 0)">
        <create_position name="$vas_epai_approach_current_pos" space="this.ship.sector" object="this.ship"/>
        <resume label="skip_waypoints_construction"/>
      </do_if>

      <!-- Fleet size is used to adjust clearance required between the fleet and blocker station -->
      <set_value name="$vas_epai_approach_fleet_size" exact="1"/>
      <do_if value="@global.$vas_epai_vffbranch_cache.{this.ship.owner}.{this.ship}.$value">
        <set_value name="$vas_epai_approach_fleet_size" exact="global.$vas_epai_vffbranch_cache.{this.ship.owner}.{this.ship}.$value.count"/>
      </do_if>

      <!-- Keep at least 20km from station bounds; larger fleets get wider clearance
           so broad formations have a better chance of passing cleanly. -->
      <set_value name="$vas_epai_approach_fleet_clearance" exact="[20km + $vas_epai_approach_fleet_size * 1km, 40km].min"/>
      <set_value name="$vas_epai_approach_route_corridor" exact="10km"/>
      <set_value name="$vas_epai_approach_initial_start_margin" exact="10km"/>
      <set_value name="$vas_epai_approach_route_failed" exact="false"/>

      <create_position name="$vas_epai_approach_current_pos" space="this.ship.sector" object="this.ship"/>
      <create_position name="$vas_epai_approach_target_pos" space="this.ship.sector" object="$primarytarget"/>
      <set_value name="$vas_epai_approach_current_blockers" exact="$blockingstations"/>

      <do_while value="$vas_epai_approach_waypoints.count lt $vas_epai_approach_max_waypoints">
        <set_value name="$vas_epai_approach_blocker" exact="$vas_epai_approach_current_blockers.{1}"/>
        <create_position name="$vas_epai_approach_blocker_pos" space="this.ship.sector" object="$vas_epai_approach_blocker"/>
        <set_value name="$vas_epai_approach_clearance" exact="$vas_epai_approach_fleet_clearance + ($vas_epai_approach_blocker.size / 2.0)"/>
        <set_value name="$vas_epai_approach_waypoint_found" exact="false"/>

        <!-- Perpendicular basis (up/right) for candidate directions around the blocker, built from
             the current_pos -> blocker_pos axis. "up" is the axis-perpendicular direction closest to
             world-Y (X4 is Y-up; the ecliptic is the X/Z plane, so a vertical detour clears
             stations most reliably); "right" completes the basis via cross product. -->
        <set_value name="$vas_epai_approach_axis_x" exact="$vas_epai_approach_blocker_pos.x - $vas_epai_approach_current_pos.x"/>
        <set_value name="$vas_epai_approach_axis_y" exact="$vas_epai_approach_blocker_pos.y - $vas_epai_approach_current_pos.y"/>
        <set_value name="$vas_epai_approach_axis_z" exact="$vas_epai_approach_blocker_pos.z - $vas_epai_approach_current_pos.z"/>
        <set_value name="$vas_epai_approach_axis_len" exact="[sqrt($vas_epai_approach_axis_x * $vas_epai_approach_axis_x + $vas_epai_approach_axis_y * $vas_epai_approach_axis_y + $vas_epai_approach_axis_z * $vas_epai_approach_axis_z), 1m].max"/>
        <set_value name="$vas_epai_approach_ax" exact="$vas_epai_approach_axis_x / $vas_epai_approach_axis_len"/>
        <set_value name="$vas_epai_approach_ay" exact="$vas_epai_approach_axis_y / $vas_epai_approach_axis_len"/>
        <set_value name="$vas_epai_approach_az" exact="$vas_epai_approach_axis_z / $vas_epai_approach_axis_len"/>

        <!-- Gram-Schmidt projection of world-Y onto the plane perpendicular to the axis. -->
        <set_value name="$vas_epai_approach_up_raw_x" exact="0 - ($vas_epai_approach_ax * $vas_epai_approach_ay)"/>
        <set_value name="$vas_epai_approach_up_raw_y" exact="1 - ($vas_epai_approach_ay * $vas_epai_approach_ay)"/>
        <set_value name="$vas_epai_approach_up_raw_z" exact="0 - ($vas_epai_approach_az * $vas_epai_approach_ay)"/>
        <set_value name="$vas_epai_approach_up_raw_len_sq" exact="$vas_epai_approach_up_raw_x * $vas_epai_approach_up_raw_x + $vas_epai_approach_up_raw_y * $vas_epai_approach_up_raw_y + $vas_epai_approach_up_raw_z * $vas_epai_approach_up_raw_z"/>

        <!-- Degenerate when the axis is near-vertical (world-Y projection collapses to ~0); fall
             back to world X/Z, which are equally valid lateral directions in that case. -->
        <do_if value="$vas_epai_approach_up_raw_len_sq lt 0.000001">
          <set_value name="$vas_epai_approach_up_x" exact="1"/>
          <set_value name="$vas_epai_approach_up_y" exact="0"/>
          <set_value name="$vas_epai_approach_up_z" exact="0"/>
          <set_value name="$vas_epai_approach_right_x" exact="0"/>
          <set_value name="$vas_epai_approach_right_y" exact="0"/>
          <set_value name="$vas_epai_approach_right_z" exact="1"/>
        </do_if>
        <do_else>
          <set_value name="$vas_epai_approach_up_raw_len" exact="sqrt($vas_epai_approach_up_raw_len_sq)"/>
          <set_value name="$vas_epai_approach_up_x" exact="$vas_epai_approach_up_raw_x / $vas_epai_approach_up_raw_len"/>
          <set_value name="$vas_epai_approach_up_y" exact="$vas_epai_approach_up_raw_y / $vas_epai_approach_up_raw_len"/>
          <set_value name="$vas_epai_approach_up_z" exact="$vas_epai_approach_up_raw_z / $vas_epai_approach_up_raw_len"/>
          <set_value name="$vas_epai_approach_right_x" exact="$vas_epai_approach_ay * $vas_epai_approach_up_z - $vas_epai_approach_az * $vas_epai_approach_up_y"/>
          <set_value name="$vas_epai_approach_right_y" exact="$vas_epai_approach_az * $vas_epai_approach_up_x - $vas_epai_approach_ax * $vas_epai_approach_up_z"/>
          <set_value name="$vas_epai_approach_right_z" exact="$vas_epai_approach_ax * $vas_epai_approach_up_y - $vas_epai_approach_ay * $vas_epai_approach_up_x"/>
        </do_else>

        <!-- 8 candidates on the cone's base circle around the blocker: cardinal directions
             (+up, -up, +right, -right) at 1x clearance, then diagonals at 2x clearance. First one
             that clears all sector enemy stations is accepted. -->
        <do_all exact="8" counter="$vas_epai_approach_dir_i">
          <set_value name="$vas_epai_approach_mult_up" exact="if $vas_epai_approach_dir_i == 1 then 1
                                                         else if $vas_epai_approach_dir_i == 2 then -1
                                                         else if $vas_epai_approach_dir_i == 3 then 0
                                                         else if $vas_epai_approach_dir_i == 4 then 0
                                                         else if $vas_epai_approach_dir_i == 5 then 1
                                                         else if $vas_epai_approach_dir_i == 6 then -1
                                                         else if $vas_epai_approach_dir_i == 7 then -1
                                                         else 1"/>
          <set_value name="$vas_epai_approach_mult_right" exact="if $vas_epai_approach_dir_i == 1 then 0
                                                            else if $vas_epai_approach_dir_i == 2 then 0
                                                            else if $vas_epai_approach_dir_i == 3 then 1
                                                            else if $vas_epai_approach_dir_i == 4 then -1
                                                            else if $vas_epai_approach_dir_i == 5 then 1
                                                            else if $vas_epai_approach_dir_i == 6 then 1
                                                            else if $vas_epai_approach_dir_i == 7 then -1
                                                            else -1"/>
          <set_value name="$vas_epai_approach_dir_radius" exact="if $vas_epai_approach_dir_i le 4 then $vas_epai_approach_clearance else $vas_epai_approach_clearance * sqrt(2)"/>

          <create_position name="$vas_epai_approach_candidate_waypoint" space="this.ship.sector"
                           x="$vas_epai_approach_blocker_pos.x + (($vas_epai_approach_up_x * $vas_epai_approach_mult_up + $vas_epai_approach_right_x * $vas_epai_approach_mult_right) * $vas_epai_approach_dir_radius)"
                           y="$vas_epai_approach_blocker_pos.y + (($vas_epai_approach_up_y * $vas_epai_approach_mult_up + $vas_epai_approach_right_y * $vas_epai_approach_mult_right) * $vas_epai_approach_dir_radius)"
                           z="$vas_epai_approach_blocker_pos.z + (($vas_epai_approach_up_z * $vas_epai_approach_mult_up + $vas_epai_approach_right_z * $vas_epai_approach_mult_right) * $vas_epai_approach_dir_radius)"/>

          <!-- Candidate waypoints are validated against all sector enemy stations, not only the
               originally blocking stations, because the detour can create new station conflicts. -->
          <set_value name="$vas_epai_approach_candidate_valid" exact="true"/>
          <set_value name="$vas_epai_approach_dx" exact="$vas_epai_approach_candidate_waypoint.x - $vas_epai_approach_current_pos.x"/>
          <set_value name="$vas_epai_approach_dy" exact="$vas_epai_approach_candidate_waypoint.y - $vas_epai_approach_current_pos.y"/>
          <set_value name="$vas_epai_approach_dz" exact="$vas_epai_approach_candidate_waypoint.z - $vas_epai_approach_current_pos.z"/>
          <set_value name="$vas_epai_approach_line_len_sq" exact="$vas_epai_approach_dx * $vas_epai_approach_dx + $vas_epai_approach_dy * $vas_epai_approach_dy + $vas_epai_approach_dz * $vas_epai_approach_dz"/>
          <set_value name="$vas_epai_approach_line_len" exact="[sqrt($vas_epai_approach_line_len_sq), 1m].max"/>

          <do_all exact="$sectorenemystations.count" counter="$vas_epai_approach_station_i">
            <set_value name="$vas_epai_approach_station" exact="$sectorenemystations.{$vas_epai_approach_station_i}"/>
            <!-- No sense to check the primary target -->
            <do_if value="$vas_epai_approach_station == $primarytarget">
              <continue/>
            </do_if>

            <!-- No sense to check the blocker that's currently being processed -->
            <do_if value="$vas_epai_approach_station == $vas_epai_approach_blocker">
              <continue/>
            </do_if>

            <!-- Endpoint clearance: the waypoint itself must stay far enough from station bounds. -->
            <set_value name="$vas_epai_approach_waypoint_clearance_radius" exact="$vas_epai_approach_fleet_clearance + ($vas_epai_approach_station.size / 2.0)"/>

            <!-- Early cheap prefilter: skip stations that are out of the route leg bubble -
                 they cannot affect this waypoint in any case -->
            <do_if value="$vas_epai_approach_station.distanceto.{$vas_epai_approach_current_pos} gt ($vas_epai_approach_line_len + $vas_epai_approach_waypoint_clearance_radius)">
              <continue/>
            </do_if>

            <!-- First reject waypoint points that are themselves too close to any sector station.
                 Segment projection below can intentionally ignore endpoint-adjacent stations, but
                 that must not allow a waypoint to be placed inside a station's clearance bubble. -->
            <do_if value="$vas_epai_approach_station.distanceto.{$vas_epai_approach_candidate_waypoint} le $vas_epai_approach_waypoint_clearance_radius">
              <set_value name="$vas_epai_approach_candidate_valid" exact="false"/>
              <break/>
            </do_if>

            <create_position name="$vas_epai_approach_station_pos" space="this.ship.sector" object="$vas_epai_approach_station"/>

            <set_value name="$vas_epai_approach_bx" exact="$vas_epai_approach_station_pos.x - $vas_epai_approach_current_pos.x"/>
            <set_value name="$vas_epai_approach_by" exact="$vas_epai_approach_station_pos.y - $vas_epai_approach_current_pos.y"/>
            <set_value name="$vas_epai_approach_bz" exact="$vas_epai_approach_station_pos.z - $vas_epai_approach_current_pos.z"/>
            <set_value name="$vas_epai_approach_dot" exact="$vas_epai_approach_bx * $vas_epai_approach_dx + $vas_epai_approach_by * $vas_epai_approach_dy + $vas_epai_approach_bz * $vas_epai_approach_dz"/>

            <!-- Projection must fall on the route segment, not behind current_pos or past the candidate waypoint. -->
            <do_if value="$vas_epai_approach_dot le 0 or $vas_epai_approach_dot gt $vas_epai_approach_line_len_sq">
              <continue/>
            </do_if>

            <!-- On the first leg, ignore blockers too close to the ship start; only mid-route blockers matter there. -->
            <do_if value="$vas_epai_approach_waypoints.count == 0">
              <set_value name="$vas_epai_approach_projection_distance" exact="$vas_epai_approach_dot / $vas_epai_approach_line_len"/>
              <do_if value="$vas_epai_approach_projection_distance lt $vas_epai_approach_initial_start_margin">
                <continue/>
              </do_if>
            </do_if>

            <!-- Route corridor: the leg line itself must not pass through station bounds. -->
            <set_value name="$vas_epai_approach_route_corridor_radius" exact="$vas_epai_approach_route_corridor + ($vas_epai_approach_station.size / 2.0)"/>
            <set_value name="$vas_epai_approach_route_corridor_radius_sq" exact="$vas_epai_approach_route_corridor_radius * $vas_epai_approach_route_corridor_radius"/>
            <set_value name="$vas_epai_approach_station_dist_sq" exact="$vas_epai_approach_bx * $vas_epai_approach_bx + $vas_epai_approach_by * $vas_epai_approach_by + $vas_epai_approach_bz * $vas_epai_approach_bz"/>
            <set_value name="$vas_epai_approach_perp_dist_sq" exact="$vas_epai_approach_station_dist_sq - (($vas_epai_approach_dot * $vas_epai_approach_dot) / $vas_epai_approach_line_len_sq)"/>

            <!-- Perpendicular distance (normale) to route line must fit inside the corridor; one hit invalidates the whole candidate. -->
            <do_if value="$vas_epai_approach_perp_dist_sq le $vas_epai_approach_route_corridor_radius_sq">
              <set_value name="$vas_epai_approach_candidate_valid" exact="false"/>
              <break/>
            </do_if>
          </do_all>

          <!-- Candidate cleared every station; accept it and stop trying the remaining 8 directions. -->
          <do_if value="$vas_epai_approach_candidate_valid">
            <append_to_list name="$vas_epai_approach_waypoints" exact="$vas_epai_approach_candidate_waypoint"/>
            <set_value name="$vas_epai_approach_current_pos" exact="$vas_epai_approach_candidate_waypoint"/>
            <set_value name="$vas_epai_approach_waypoint_found" exact="true"/>
            <break/>
          </do_if>
        </do_all>

        <do_if value="not $vas_epai_approach_waypoint_found">
          <set_value name="$vas_epai_approach_route_failed" exact="true"/>
          <break/>
        </do_if>

        <!-- Rebuild blockers from the accepted waypoint to the target.
             First iteration consumed scan-provided blockingstations directly; only later route
             state is recomputed against all sector enemy stations. -->
        <set_value name="$vas_epai_approach_current_blockers" exact="[]"/>
        <set_value name="$vas_epai_approach_dx" exact="$vas_epai_approach_target_pos.x - $vas_epai_approach_current_pos.x"/>
        <set_value name="$vas_epai_approach_dy" exact="$vas_epai_approach_target_pos.y - $vas_epai_approach_current_pos.y"/>
        <set_value name="$vas_epai_approach_dz" exact="$vas_epai_approach_target_pos.z - $vas_epai_approach_current_pos.z"/>
        <set_value name="$vas_epai_approach_line_len_sq" exact="$vas_epai_approach_dx * $vas_epai_approach_dx + $vas_epai_approach_dy * $vas_epai_approach_dy + $vas_epai_approach_dz * $vas_epai_approach_dz"/>
        <set_value name="$vas_epai_approach_line_len" exact="[sqrt($vas_epai_approach_line_len_sq), 1m].max"/>

        <!-- Early break because sum of squared values is less than or equal to zero.
             This particular guard makes my LLM agent especially happy.
             I would remove it if that insistent agent wont apply it again later. So let it be. -->
        <do_if value="$vas_epai_approach_line_len_sq le 0">
          <break/>
        </do_if>

        <do_all exact="$sectorenemystations.count" counter="$vas_epai_approach_station_i">
          <set_value name="$vas_epai_approach_station" exact="$sectorenemystations.{$vas_epai_approach_station_i}"/>
          <!-- No sense to check the primary target -->
          <do_if value="$vas_epai_approach_station == $primarytarget">
            <continue/>
          </do_if>

          <!-- Endpoint and prefilter clearance -->
          <set_value name="$vas_epai_approach_waypoint_clearance_radius" exact="$vas_epai_approach_fleet_clearance + ($vas_epai_approach_station.size / 2.0)"/>

          <!-- Early cheap prefilter: skip stations that cannot affect this waypoint -
               waypoint was already checked against this station just a few lines ago
               with "break" for a waypoint with that waypoint invalidation, BUT
               it does mean exactly that it can be safely skipped here -->
          <do_if value="$vas_epai_approach_station.distanceto.{$vas_epai_approach_current_pos} le $vas_epai_approach_waypoint_clearance_radius">
            <continue/>
          </do_if>

          <!-- Early cheap prefilter: skip stations that are out of the route leg bubble -
               they cannot be blockers in any case. This assumes that this route leg is from
               current_pos (last waypoint) till the target - if no blockers are found at all this will be true,
               otherwise it's still ok to remove stations that cannot affect -->
          <do_if value="$vas_epai_approach_station.distanceto.{$vas_epai_approach_current_pos} gt ($vas_epai_approach_line_len + $vas_epai_approach_waypoint_clearance_radius)">
            <continue/>
          </do_if>

          <create_position name="$vas_epai_approach_station_pos" space="this.ship.sector" object="$vas_epai_approach_station"/>
          <set_value name="$vas_epai_approach_bx" exact="$vas_epai_approach_station_pos.x - $vas_epai_approach_current_pos.x"/>
          <set_value name="$vas_epai_approach_by" exact="$vas_epai_approach_station_pos.y - $vas_epai_approach_current_pos.y"/>
          <set_value name="$vas_epai_approach_bz" exact="$vas_epai_approach_station_pos.z - $vas_epai_approach_current_pos.z"/>
          <set_value name="$vas_epai_approach_dot" exact="$vas_epai_approach_bx * $vas_epai_approach_dx + $vas_epai_approach_by * $vas_epai_approach_dy + $vas_epai_approach_bz * $vas_epai_approach_dz"/>

          <!-- Target-near stations are ignored only if they are outside the target-end approach cone.
               The cone apex is the target; its base is the route corridor at target clearance range. -->
          <do_if value="$vas_epai_approach_station.distanceto.{$primarytarget} le $vas_epai_approach_waypoint_clearance_radius">
            <set_value name="$vas_epai_approach_target_cone_station_dist_sq" exact="$vas_epai_approach_bx * $vas_epai_approach_bx + $vas_epai_approach_by * $vas_epai_approach_by + $vas_epai_approach_bz * $vas_epai_approach_bz"/>
            <set_value name="$vas_epai_approach_target_cone_perp_dist_sq" exact="$vas_epai_approach_target_cone_station_dist_sq - (($vas_epai_approach_dot * $vas_epai_approach_dot) / $vas_epai_approach_line_len_sq)"/>
            <set_value name="$vas_epai_approach_target_cone_distance_from_target" exact="$vas_epai_approach_line_len - ($vas_epai_approach_dot / $vas_epai_approach_line_len)"/>
            <set_value name="$vas_epai_approach_target_cone_base_radius" exact="$vas_epai_approach_route_corridor + ($vas_epai_approach_station.size / 2.0)"/>
            <set_value name="$vas_epai_approach_target_cone_radius" exact="$vas_epai_approach_target_cone_base_radius * ([$vas_epai_approach_target_cone_distance_from_target, 0m].max / $vas_epai_approach_waypoint_clearance_radius)"/>
            <set_value name="$vas_epai_approach_target_cone_radius_sq" exact="$vas_epai_approach_target_cone_radius * $vas_epai_approach_target_cone_radius"/>
            <do_if value="$vas_epai_approach_target_cone_distance_from_target le 0m
                      or $vas_epai_approach_target_cone_distance_from_target gt $vas_epai_approach_waypoint_clearance_radius
                      or $vas_epai_approach_target_cone_perp_dist_sq gt $vas_epai_approach_target_cone_radius_sq">
              <continue/>
            </do_if>
          </do_if>

          <!-- Projection must fall on the route segment, not behind current waypoint or past target. -->
          <do_if value="$vas_epai_approach_dot le 0 or $vas_epai_approach_dot gt $vas_epai_approach_line_len_sq">
            <continue/>
          </do_if>

          <!-- Stations cannot move into the route, so use fixed corridor radius plus station bounds. -->
          <set_value name="$vas_epai_approach_station_radius" exact="$vas_epai_approach_route_corridor + ($vas_epai_approach_station.size / 2.0)"/>
          <set_value name="$vas_epai_approach_station_radius_sq" exact="$vas_epai_approach_station_radius * $vas_epai_approach_station_radius"/>
          <set_value name="$vas_epai_approach_station_dist_sq" exact="$vas_epai_approach_bx * $vas_epai_approach_bx + $vas_epai_approach_by * $vas_epai_approach_by + $vas_epai_approach_bz * $vas_epai_approach_bz"/>
          <set_value name="$vas_epai_approach_perp_dist_sq" exact="$vas_epai_approach_station_dist_sq - (($vas_epai_approach_dot * $vas_epai_approach_dot) / $vas_epai_approach_line_len_sq)"/>

          <!-- Perpendicular distance (normale) to route line must fit inside the corridor. -->
          <do_if value="$vas_epai_approach_perp_dist_sq le $vas_epai_approach_station_radius_sq">
            <append_to_list name="$vas_epai_approach_current_blockers" exact="$vas_epai_approach_station"/>
          </do_if>
        </do_all>

        <!-- No blockers from the current waypoint - break the waypoint-seeking loop -->
        <do_if value="$vas_epai_approach_current_blockers.count == 0">
          <break/>
        </do_if>
      </do_while>

      <!-- If bounded route construction fails, try already-validated endpoints as best effort. -->
      <!-- <do_if value="$vas_epai_approach_route_failed">
        <set_value name="$vas_epai_approach_waypoints" exact="[]"/>
        <create_position name="$vas_epai_approach_current_pos" space="this.ship.sector" object="this.ship"/>
      </do_if> -->

      <label name="skip_waypoints_construction"/>

      <!-- For station targets - issue a move order to approach near that station.
           Do not issue move order with station as a target - it produces weird move destination -->
      <do_if value="$primarytarget.isclass.station">
        <set_value name="$vas_epai_station_approach_anchor" exact="$primarytarget"/>
        <set_value name="$vas_epai_station_approach_distance" exact="(this.ship.currentradarrange + ($primarytarget.size / 2.0)) * 0.99"/>
        <create_position name="$vas_epai_station_approach_anchor_pos" space="this.ship.sector" object="$vas_epai_station_approach_anchor"/>
        <set_value name="$vas_epai_station_approach_distance_from_current" exact="[$vas_epai_station_approach_anchor.distanceto.{$vas_epai_approach_current_pos}, 1m].max"/>
        <set_value name="$vas_epai_station_approach_proportion" exact="[$vas_epai_station_approach_distance / $vas_epai_station_approach_distance_from_current, 1.0].min"/>
        <create_position name="$vas_epai_station_approach_pos" space="this.ship.sector"
                         x="$vas_epai_station_approach_anchor_pos.x + (($vas_epai_approach_current_pos.x - $vas_epai_station_approach_anchor_pos.x) * $vas_epai_station_approach_proportion)"
                         y="$vas_epai_station_approach_anchor_pos.y + (($vas_epai_approach_current_pos.y - $vas_epai_station_approach_anchor_pos.y) * $vas_epai_station_approach_proportion)"
                         z="$vas_epai_station_approach_anchor_pos.z + (($vas_epai_approach_current_pos.z - $vas_epai_station_approach_anchor_pos.z) * $vas_epai_station_approach_proportion)"/>
        <create_order id="'MoveGeneric'" object="this.ship" immediate="true">
          <param name="destination" value="$vas_epai_station_approach_anchor.sector"/>
          <param name="position" value="$vas_epai_station_approach_pos"/>
          <param name="stopondetect" value="$primarytarget"/>
        </create_order>
      </do_if>
      <do_else> <!-- value="$primarytarget.isclass.ship" because we have only stations and ships as targets -->
        <!-- If the approach is mutual, then stop on detect would stop the final MoveGeneric order
             and attack order would take action. -->
        <create_order id="'MoveGeneric'" object="this.ship" immediate="true">
          <param name="destination" value="$primarytarget"/>
          <param name="pursuetargets" value="true"/>
          <param name="stopondetect" value="$primarytarget"/>
          <param name="vas_epai_issued_by_epai" value="true"/>
        </create_order>
      </do_else>

      <!-- Immediate orders execute stack-style here: Attack was issued first, the final leg above
           was issued second, and these fixed detour legs are issued from end to start so the first
           waypoint becomes the next order to execute. -->
      <do_all exact="$vas_epai_approach_waypoints.count" counter="$vas_epai_approach_order_i">
        <set_value name="$vas_epai_approach_waypoint_index" exact="$vas_epai_approach_waypoints.count + 1 - $vas_epai_approach_order_i"/>
        <create_order id="'MoveGeneric'" object="this.ship" immediate="true">
          <param name="destination" value="this.ship.sector"/>
          <param name="position" value="$vas_epai_approach_waypoints.{$vas_epai_approach_waypoint_index}"/>
          <param name="stopondetect" value="$primarytarget"/>
        </create_order>
      </do_all>
    </actions>
  </attention>
</aiscript>
