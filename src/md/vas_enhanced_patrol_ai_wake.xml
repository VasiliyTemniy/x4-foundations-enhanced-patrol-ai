<?xml version="1.0" encoding="utf-8"?>
<mdscript name="VAS_EnhancedPatrolAI_Wake" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <!--
    EPAI scan scheduler.
    Vanilla move.seekenemies interrupts are left to vanilla logic; this cue sends EPAI-only wake signals.
    Sectors are split into buckets so the mod does not signal every sector on the same second.
    -->
  <cues>
    <cue name="InitWakeBuckets" instantiate="true">
      <conditions>
        <event_universe_generated/>
      </conditions>
      <actions>
        <run_actions ref="BuildWakeBuckets"/>
      </actions>
    </cue>

    <cue name="WakeBucketsRefresh" checkinterval="30" instantiate="true">
      <actions>
        <!-- Rebuild periodically so config interval changes and sector-list changes heal without save-state fuss. -->
        <run_actions ref="BuildWakeBuckets"/>
      </actions>
    </cue>

    <library name="BuildWakeBuckets" purpose="run_actions">
      <actions>
        <!-- One bucket is signalled per second; bucket count therefore matches the configured scan interval in seconds. -->
        <set_value name="$vas_epai_wake_bucket_count" exact="if (@player.entity.$vas_epai_interval + '') == 'null' then 30 else [(player.entity.$vas_epai_interval / 1s)i, 1].max"/>
        <set_value name="global.$vas_epai_wake_bucket_count" exact="$vas_epai_wake_bucket_count"/>
        <set_value name="global.$vas_epai_wake_buckets" exact="table[]"/>
        <do_all exact="$vas_epai_wake_bucket_count" counter="$vas_epai_wake_bucket_index">
          <set_value name="global.$vas_epai_wake_buckets.{$vas_epai_wake_bucket_index}" exact="[]"/>
        </do_all>

        <find_sector name="$vas_epai_wake_sectors" multiple="true"/>
        <!-- Round-robin distribution keeps each 1-second wake tick roughly the same size. -->
        <set_value name="$vas_epai_wake_bucket_index" exact="1"/>
        <do_for_each name="$vas_epai_wake_sector" in="$vas_epai_wake_sectors">
          <append_to_list name="global.$vas_epai_wake_buckets.{$vas_epai_wake_bucket_index}" exact="$vas_epai_wake_sector"/>
          <set_value name="$vas_epai_wake_bucket_index" exact="$vas_epai_wake_bucket_index + 1"/>
          <do_if value="$vas_epai_wake_bucket_index gt $vas_epai_wake_bucket_count">
            <set_value name="$vas_epai_wake_bucket_index" exact="1"/>
          </do_if>
        </do_for_each>

        <do_if value="not @global.$vas_epai_wake_bucket_index or global.$vas_epai_wake_bucket_index gt $vas_epai_wake_bucket_count">
          <set_value name="global.$vas_epai_wake_bucket_index" exact="1"/>
        </do_if>
      </actions>
    </library>

    <cue name="WakeTick" checkinterval="1" instantiate="true">
      <actions>
        <!-- Init wake tickets -->
        <do_if value="not @global.$vas_epai_wake_ticket">
          <set_value name="global.$vas_epai_wake_ticket" exact="table[]"/>
        </do_if>

        <!-- Signal only the current bucket; move.seekenemies still has its own per-ship interval gate. -->
        <do_if value="@global.$vas_epai_wake_buckets and @global.$vas_epai_wake_bucket_count">
          <do_if value="not @global.$vas_epai_wake_bucket_index or global.$vas_epai_wake_bucket_index gt global.$vas_epai_wake_bucket_count">
            <set_value name="global.$vas_epai_wake_bucket_index" exact="1"/>
          </do_if>

          <set_value name="$vas_epai_wake_bucket_index" exact="global.$vas_epai_wake_bucket_index"/>
          <set_value name="$vas_epai_wake_sectors" exact="global.$vas_epai_wake_buckets.{$vas_epai_wake_bucket_index}"/>
          <do_if value="@$vas_epai_wake_sectors.count">
            <do_for_each name="$vas_epai_wake_sector" in="$vas_epai_wake_sectors">
              <!-- Reset this sector's per-wake ticket so move.seekenemies can stagger same-tick ships;
                   safe because a sector lives in exactly one bucket and is signalled at most once per interval. -->
              <set_value name="global.$vas_epai_wake_ticket.{$vas_epai_wake_sector}" exact="0"/>
              <signal_objects object="$vas_epai_wake_sector" param="'wake_up_patrol'"/>
            </do_for_each>
          </do_if>

          <set_value name="global.$vas_epai_wake_bucket_index" exact="global.$vas_epai_wake_bucket_index + 1"/>
          <do_if value="global.$vas_epai_wake_bucket_index gt global.$vas_epai_wake_bucket_count">
            <set_value name="global.$vas_epai_wake_bucket_index" exact="1"/>
          </do_if>
        </do_if>
      </actions>
    </cue>
  </cues>
</mdscript>
