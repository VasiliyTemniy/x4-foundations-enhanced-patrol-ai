<?xml version="1.0" encoding="utf-8"?>
<mdscript name="VAS_EnhancedPatrolAI_Config" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="md.xsd">
  <!--
    Config state + Extension Options UI for Enhanced Patrol AI. The gameplay
    lives in aiscripts; they read the player.entity.$vas_epai_* mirrors, which
    are re-pushed from ModConfig on every load by InitDefaults.
  -->
  <cues>
    <!-- Config STATE container. Defaults live in exactly one place: SeedDefaults. -->
    <cue name="ModConfig" namespace="this">
      <actions>
        <run_actions ref="SeedDefaults"/>
      </actions>
    </cue>

    <!--@doc
        Idempotent defaults seeder. String-coercion null checks: explicit
        false/0 must NOT be re-seeded. -->
    <library name="SeedDefaults" purpose="run_actions">
      <actions>
        <set_value name="$defaults" exact="table[
          $applyToNpcFactions = true,
          $applyToXenon = false,
          $applyToKhaak = false,
          $attackShips = true,
          $attackStations = true,
          $skipShipMayattack = false,
          $skipStationMayattack = true,
          $allSeeing = false,
          $alliedVision = true,
          $intervalSec = 30,
          $maxPursueTravelDistanceKm = 800,
          $maxAttackInitDistanceKm = 800,
          $approachMaxWaypoints = 4,
          $shipJoinThresholdPct = 10,
          $shipOvercommitLimit = 10,
          $stationJoinThresholdPct = 3,
          $stationInitiationThresholdPct = 15,
          $pendingPatrolForceCoeffPct = 50,
          $forceEstimationDeviationPct = 10,
          $debugEnabled = false,
        ]"/>
        <do_for_each name="$key" in="$defaults.keys.list">
          <do_if value="(@md.VAS_EnhancedPatrolAI_Config.ModConfig.{$key} + '') == 'null'">
            <set_value name="md.VAS_EnhancedPatrolAI_Config.ModConfig.{$key}" exact="$defaults.{$key}"/>
          </do_if>
        </do_for_each>
      </actions>
    </library>

    <!-- event_universe_generated fires both at new-game start AND on every
         savegame load (md.xsd), so it alone covers all sessions. Seeds defaults
         and re-pushes all aiscript blackboard mirrors (with unit conversions). -->
    <cue name="InitDefaults" instantiate="true">
      <conditions>
        <event_universe_generated/>
      </conditions>
      <actions>
        <run_actions ref="SeedDefaults"/>
        <run_actions ref="PushMirrors"/>
        <run_actions ref="RegisterWithCombatLogic"/>
      </actions>
    </cue>

    <!--@doc
        Registers this consumer with Combat Logic: patrolling ships count as potential ally
        combatants for every CL consumer, and the wake heartbeat runs at least this dense.
        Note the registry REPLACES CL's ['Patrol'] fallback once any consumer registers, so
        Patrol must be appended explicitly here. -->
    <library name="RegisterWithCombatLogic" purpose="run_actions">
      <actions>
        <do_if value="not @global.$vas_cl_combat_order_ids">
          <set_value name="global.$vas_cl_combat_order_ids" exact="[]"/>
        </do_if>
        <do_if value="not global.$vas_cl_combat_order_ids.indexof.{'Patrol'}">
          <append_to_list name="global.$vas_cl_combat_order_ids" exact="'Patrol'"/>
        </do_if>
        <do_if value="not @global.$vas_cl_wake_intervals">
          <set_value name="global.$vas_cl_wake_intervals" exact="table[]"/>
        </do_if>
        <set_value name="global.$vas_cl_wake_intervals.{'$vas_epai'}" exact="md.VAS_EnhancedPatrolAI_Config.ModConfig.$intervalSec * 1s"/>
      </actions>
    </library>

    <!--@doc
        Pushes every ModConfig value onto the player blackboard in the units the
        aiscripts consume directly (time, distance, ratios). -->
    <library name="PushMirrors" purpose="run_actions">
      <actions>
        <set_value name="player.entity.$vas_epai_apply_to_npc_factions" exact="md.VAS_EnhancedPatrolAI_Config.ModConfig.$applyToNpcFactions"/>
        <set_value name="player.entity.$vas_epai_apply_to_xenon" exact="md.VAS_EnhancedPatrolAI_Config.ModConfig.$applyToXenon"/>
        <set_value name="player.entity.$vas_epai_apply_to_khaak" exact="md.VAS_EnhancedPatrolAI_Config.ModConfig.$applyToKhaak"/>
        <set_value name="player.entity.$vas_epai_attack_ships" exact="md.VAS_EnhancedPatrolAI_Config.ModConfig.$attackShips"/>
        <set_value name="player.entity.$vas_epai_attack_stations" exact="md.VAS_EnhancedPatrolAI_Config.ModConfig.$attackStations"/>
        <set_value name="player.entity.$vas_epai_skip_ship_mayattack" exact="md.VAS_EnhancedPatrolAI_Config.ModConfig.$skipShipMayattack"/>
        <set_value name="player.entity.$vas_epai_skip_station_mayattack" exact="md.VAS_EnhancedPatrolAI_Config.ModConfig.$skipStationMayattack"/>
        <set_value name="player.entity.$vas_epai_all_seeing" exact="md.VAS_EnhancedPatrolAI_Config.ModConfig.$allSeeing"/>
        <set_value name="player.entity.$vas_epai_allied_vision" exact="md.VAS_EnhancedPatrolAI_Config.ModConfig.$alliedVision"/>
        <set_value name="player.entity.$vas_epai_debug_chance" exact="if md.VAS_EnhancedPatrolAI_Config.ModConfig.$debugEnabled then 100 else 0"/>
        <set_value name="player.entity.$vas_epai_interval" exact="md.VAS_EnhancedPatrolAI_Config.ModConfig.$intervalSec * 1s"/>
        <set_value name="player.entity.$vas_epai_max_pursue_travel_distance" exact="md.VAS_EnhancedPatrolAI_Config.ModConfig.$maxPursueTravelDistanceKm * 1km"/>
        <set_value name="player.entity.$vas_epai_max_attack_init_distance" exact="md.VAS_EnhancedPatrolAI_Config.ModConfig.$maxAttackInitDistanceKm * 1km"/>
        <set_value name="player.entity.$vas_epai_approach_max_waypoints" exact="md.VAS_EnhancedPatrolAI_Config.ModConfig.$approachMaxWaypoints"/>
        <set_value name="player.entity.$vas_epai_ship_join_threshold" exact="md.VAS_EnhancedPatrolAI_Config.ModConfig.$shipJoinThresholdPct / 100.0"/>
        <set_value name="player.entity.$vas_epai_ship_overcommit_limit" exact="md.VAS_EnhancedPatrolAI_Config.ModConfig.$shipOvercommitLimit"/>
        <set_value name="player.entity.$vas_epai_station_join_threshold" exact="md.VAS_EnhancedPatrolAI_Config.ModConfig.$stationJoinThresholdPct / 100.0"/>
        <set_value name="player.entity.$vas_epai_station_initiation_threshold" exact="md.VAS_EnhancedPatrolAI_Config.ModConfig.$stationInitiationThresholdPct / 100.0"/>
        <set_value name="player.entity.$vas_epai_pending_patrol_force_coefficient" exact="md.VAS_EnhancedPatrolAI_Config.ModConfig.$pendingPatrolForceCoeffPct / 100.0"/>
        <set_value name="player.entity.$vas_epai_force_estimation_deviation" exact="md.VAS_EnhancedPatrolAI_Config.ModConfig.$forceEstimationDeviationPct / 100.0"/>
      </actions>
    </library>

