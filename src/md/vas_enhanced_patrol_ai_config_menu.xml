    <cue name="OnOptionsCheckboxChanged" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <set_value name="md.VAS_EnhancedPatrolAI_Config.ModConfig.{'$' + event.param.$id}" exact="event.param.$checked"/>
        <do_if value="event.param.$id == 'debugEnabled'">
          <do_if value="event.param.$checked">
            <set_value name="player.entity.$vas_epai_debug_chance" exact="100"/>
          </do_if>
          <do_else>
            <set_value name="player.entity.$vas_epai_debug_chance" exact="0"/>
          </do_else>
        </do_if>
        <do_elseif value="event.param.$id == 'applyToNpcFactions'">
          <set_value name="player.entity.$vas_epai_apply_to_npc_factions" exact="event.param.$checked"/>
        </do_elseif>
        <do_elseif value="event.param.$id == 'applyToXenon'">
          <set_value name="player.entity.$vas_epai_apply_to_xenon" exact="event.param.$checked"/>
        </do_elseif>
        <do_elseif value="event.param.$id == 'applyToKhaak'">
          <set_value name="player.entity.$vas_epai_apply_to_khaak" exact="event.param.$checked"/>
        </do_elseif>
        <do_elseif value="event.param.$id == 'attackShips'">
          <set_value name="player.entity.$vas_epai_attack_ships" exact="event.param.$checked"/>
        </do_elseif>
        <do_elseif value="event.param.$id == 'attackStations'">
          <set_value name="player.entity.$vas_epai_attack_stations" exact="event.param.$checked"/>
        </do_elseif>
        <do_elseif value="event.param.$id == 'skipShipMayattack'">
          <set_value name="player.entity.$vas_epai_skip_ship_mayattack" exact="event.param.$checked"/>
        </do_elseif>
        <do_elseif value="event.param.$id == 'skipStationMayattack'">
          <set_value name="player.entity.$vas_epai_skip_station_mayattack" exact="event.param.$checked"/>
        </do_elseif>
        <do_elseif value="event.param.$id == 'allSeeing'">
          <set_value name="player.entity.$vas_epai_all_seeing" exact="event.param.$checked"/>
        </do_elseif>
        <do_elseif value="event.param.$id == 'alliedVision'">
          <set_value name="player.entity.$vas_epai_allied_vision" exact="event.param.$checked"/>
        </do_elseif>
        <cancel_cue cue="this"/>
      </actions>
    </cue>

    <cue name="OnOptionsSliderChanged" instantiate="true">
      <conditions>
        <event_cue_signalled/>
      </conditions>
      <actions>
        <do_if value="event.param.$echo == 'intervalSec'">
          <set_value name="md.VAS_EnhancedPatrolAI_Config.ModConfig.$intervalSec" exact="event.param.$value"/>
          <set_value name="player.entity.$vas_epai_interval" exact="event.param.$value * 1s"/>
          <!-- Keep the Combat Logic wake heartbeat registration in step; the CL bucket refresh picks it up. -->
          <do_if value="not @global.$vas_cl_wake_intervals">
            <set_value name="global.$vas_cl_wake_intervals" exact="table[]"/>
          </do_if>
          <set_value name="global.$vas_cl_wake_intervals.{'$vas_epai'}" exact="event.param.$value * 1s"/>
        </do_if>
        <do_elseif value="event.param.$echo == 'maxPursueTravelDistanceKm'">
          <set_value name="md.VAS_EnhancedPatrolAI_Config.ModConfig.$maxPursueTravelDistanceKm" exact="event.param.$value"/>
          <set_value name="player.entity.$vas_epai_max_pursue_travel_distance" exact="event.param.$value * 1km"/>
        </do_elseif>
        <do_elseif value="event.param.$echo == 'maxAttackInitDistanceKm'">
          <set_value name="md.VAS_EnhancedPatrolAI_Config.ModConfig.$maxAttackInitDistanceKm" exact="event.param.$value"/>
          <set_value name="player.entity.$vas_epai_max_attack_init_distance" exact="event.param.$value * 1km"/>
        </do_elseif>
        <do_elseif value="event.param.$echo == 'approachMaxWaypoints'">
          <set_value name="md.VAS_EnhancedPatrolAI_Config.ModConfig.$approachMaxWaypoints" exact="event.param.$value"/>
          <set_value name="player.entity.$vas_epai_approach_max_waypoints" exact="event.param.$value"/>
        </do_elseif>
        <do_elseif value="event.param.$echo == 'shipJoinThresholdPct'">
          <set_value name="md.VAS_EnhancedPatrolAI_Config.ModConfig.$shipJoinThresholdPct" exact="event.param.$value"/>
          <set_value name="player.entity.$vas_epai_ship_join_threshold" exact="event.param.$value / 100.0"/>
        </do_elseif>
        <do_elseif value="event.param.$echo == 'shipOvercommitLimit'">
          <set_value name="md.VAS_EnhancedPatrolAI_Config.ModConfig.$shipOvercommitLimit" exact="event.param.$value"/>
          <set_value name="player.entity.$vas_epai_ship_overcommit_limit" exact="event.param.$value"/>
        </do_elseif>
        <do_elseif value="event.param.$echo == 'stationJoinThresholdPct'">
          <set_value name="md.VAS_EnhancedPatrolAI_Config.ModConfig.$stationJoinThresholdPct" exact="event.param.$value"/>
          <set_value name="player.entity.$vas_epai_station_join_threshold" exact="event.param.$value / 100.0"/>
        </do_elseif>
        <do_elseif value="event.param.$echo == 'stationInitiationThresholdPct'">
          <set_value name="md.VAS_EnhancedPatrolAI_Config.ModConfig.$stationInitiationThresholdPct" exact="event.param.$value"/>
          <set_value name="player.entity.$vas_epai_station_initiation_threshold" exact="event.param.$value / 100.0"/>
        </do_elseif>
        <do_elseif value="event.param.$echo == 'pendingPatrolForceCoeffPct'">
          <set_value name="md.VAS_EnhancedPatrolAI_Config.ModConfig.$pendingPatrolForceCoeffPct" exact="event.param.$value"/>
          <set_value name="player.entity.$vas_epai_pending_patrol_force_coefficient" exact="event.param.$value / 100.0"/>
        </do_elseif>
        <do_elseif value="event.param.$echo == 'forceEstimationDeviationPct'">
          <set_value name="md.VAS_EnhancedPatrolAI_Config.ModConfig.$forceEstimationDeviationPct" exact="event.param.$value"/>
          <set_value name="player.entity.$vas_epai_force_estimation_deviation" exact="event.param.$value / 100.0"/>
        </do_elseif>
        <cancel_cue cue="this"/>
      </actions>
    </cue>
  </cues>
</mdscript>
